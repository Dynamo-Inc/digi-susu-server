{
  "name": "susu-engine",
  "version": "1.0.0",
  "main": "server.js",
  "author": "manuel2u",
  "license": "ISC",
  "scripts": {
    "start": "node dist/src/server.js",
    "prestart": "yarn db",
    "db": "npx sequelize-cli db:migrate",
    "migration": "npx sequelize-cli migration:create --name",
    "dev": "yarn db && nodemon src/server.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "build": "sh build.sh",
    "predev": "cross-env NODE_ENV=development yarn db",
    "db:reset": "sequelize db:drop && sequelize db:create && sequelize db:migrate",
    "db:create:test": "cross-env NODE_ENV=test npx sequelize-cli db:create"
  },
  "dependencies": {
